{
  "info": {
    "name": "RuoYi-Vue v3.9.2 接口集合",
    "_postman_id": "ruoyi-vue-392-api-20260727",
    "description": "RuoYi-Vue v3.9.2 后台管理系统核心接口集合，覆盖认证、用户管理、角色管理三大模块。\n\n使用说明：\n1. 将集合变量 {{baseUrl}} 设为实际后端地址（默认 http://localhost:8080）\n2. 先执行「获取验证码」再执行「用户登录」\n3. 登录成功后 Tests 脚本自动将 token 存入集合变量，后续接口自动带鉴权",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "uuid",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "roleId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 认证模块",
      "item": [
        {
          "name": "1.1 获取验证码",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/captchaImage",
              "host": ["{{baseUrl}}"],
              "path": ["captchaImage"]
            },
            "description": "登录前调用，获取验证码 base64 图片与 uuid。\nTests 脚本自动提取 uuid 存入集合变量 {{uuid}}。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json && json.uuid) {",
                  "    pm.collectionVariables.set(\"uuid\", json.uuid);",
                  "    console.log(\"已提取 uuid = \" + json.uuid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\",\n    \"code\": \"\",\n    \"uuid\": \"{{uuid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "账号密码登录，测试环境 captchaEnabled=false 时 code 传空即可。\nTests 脚本自动提取 token 存入集合变量 {{token}}。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"登录 HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test(\"登录业务 code=200\", function () { pm.expect(json.code).to.eql(200); });",
                  "if (json && json.token) {",
                  "    pm.collectionVariables.set(\"token\", json.token);",
                  "    console.log(\"已提取 token（前10位） = \" + json.token.substring(0, 10) + \"...\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 退出登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            },
            "description": "清除服务端 Token 映射缓存。"
          }
        },
        {
          "name": "1.4 获取用户信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/getInfo",
              "host": ["{{baseUrl}}"],
              "path": ["getInfo"]
            },
            "description": "返回当前登录用户基础信息、roles、permissions。"
          }
        }
      ]
    },
    {
      "name": "2. 用户管理模块",
      "item": [
        {
          "name": "2.1 用户列表查询",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/system/user/list?pageNum=1&pageSize=10&userName=&phonenumber=&status=&deptId=",
              "host": ["{{baseUrl}}"],
              "path": ["system", "user", "list"],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "userName",
                  "value": ""
                },
                {
                  "key": "phonenumber",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": ""
                },
                {
                  "key": "deptId",
                  "value": ""
                }
              ]
            },
            "description": "用户列表分页查询，支持 userName 模糊、phonenumber 精确、status 状态、deptId 部门过滤。"
          }
        },
        {
          "name": "2.2 新增用户",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"deptId\": 103,\n    \"userName\": \"ruoyitest\",\n    \"nickName\": \"ruoyitest\",\n    \"email\": \"ruoyitest@163.com\",\n    \"phonenumber\": \"13800000001\",\n    \"sex\": \"1\",\n    \"status\": \"0\",\n    \"remark\": \"Postman接口测试创建\",\n    \"postIds\": [],\n    \"roleIds\": [2],\n    \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/system/user",
              "host": ["{{baseUrl}}"],
              "path": ["system", "user"]
            },
            "description": "新增用户，deptId 对应部门、roleIds 数组分配角色。"
          }
        },
        {
          "name": "2.3 修改用户",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": {{userId}},\n    \"deptId\": 103,\n    \"userName\": \"ruoyitest\",\n    \"nickName\": \"ruoyitest_modified\",\n    \"email\": \"ruoyitest_modified@163.com\",\n    \"phonenumber\": \"13800000002\",\n    \"sex\": \"1\",\n    \"status\": \"0\",\n    \"remark\": \"Postman接口测试修改\",\n    \"postIds\": [],\n    \"roleIds\": [2]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/system/user",
              "host": ["{{baseUrl}}"],
              "path": ["system", "user"]
            },
            "description": "修改用户，必填 userId，使用集合变量 {{userId}} 默认值 1，可改为实际存在的 userId。"
          }
        },
        {
          "name": "2.4 删除用户",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/system/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["system", "user", "{{userId}}"]
            },
            "description": "删除单个用户，支持逗号分隔的批量 userId。使用集合变量 {{userId}} 占位。"
          }
        },
        {
          "name": "2.5 重置密码",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": {{userId}},\n    \"password\": \"ruoyi123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/system/user/resetPwd",
              "host": ["{{baseUrl}}"],
              "path": ["system", "user", "resetPwd"]
            },
            "description": "管理员重置指定用户密码为新值。"
          }
        }
      ]
    },
    {
      "name": "3. 角色管理模块",
      "item": [
        {
          "name": "3.1 角色列表查询",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/system/role/list?pageNum=1&pageSize=10&roleName=&roleKey=&status=",
              "host": ["{{baseUrl}}"],
              "path": ["system", "role", "list"],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "roleName",
                  "value": ""
                },
                {
                  "key": "roleKey",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": ""
                }
              ]
            },
            "description": "角色列表分页查询，支持 roleName 模糊、roleKey 精确、status 状态过滤。"
          }
        },
        {
          "name": "3.2 新增角色",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"roleName\": \"接口测试角色\",\n    \"roleKey\": \"api_test_role\",\n    \"roleSort\": 3,\n    \"status\": \"0\",\n    \"remark\": \"Postman接口测试创建\",\n    \"menuIds\": [1,2,3,4,5,100,101,102,103,104,105],\n    \"deptIds\": [100,101,102,103],\n    \"dataScope\": \"2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/system/role",
              "host": ["{{baseUrl}}"],
              "path": ["system", "role"]
            },
            "description": "新增角色；dataScope=1全部/2自定义/3本部门/4本部门及以下/5仅本人；menuIds 分配菜单权限；deptIds 与 dataScope=2 搭配指定自定义数据权限部门列表。"
          }
        },
        {
          "name": "3.3 修改角色",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"roleId\": {{roleId}},\n    \"roleName\": \"接口测试角色_修改\",\n    \"roleKey\": \"api_test_role\",\n    \"roleSort\": 4,\n    \"status\": \"0\",\n    \"remark\": \"Postman接口测试修改\",\n    \"menuIds\": [1,2,3,4,5],\n    \"deptIds\": [100,101],\n    \"dataScope\": \"3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/system/role",
              "host": ["{{baseUrl}}"],
              "path": ["system", "role"]
            },
            "description": "修改角色，必填 roleId，使用集合变量 {{roleId}} 默认值 1，可改为实际存在的 roleId。"
          }
        },
        {
          "name": "3.4 删除角色",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/system/role/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["system", "role", "{{roleId}}"]
            },
            "description": "删除单个角色；支持逗号分隔批量删除；若角色已被用户引用将被拦截。"
          }
        }
      ]
    }
  ]
}
